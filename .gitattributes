# Git can otherwise turn shell scripts into Windows CRLF text, which breaks the
# first line on macOS/Linux. These rules preserve the right line endings.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.cs text eol=lf
*.csproj text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
